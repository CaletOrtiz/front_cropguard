                  begin: Alignment.topCenter,
                  end: Alignment.bottomCenter,
                  colors: [Color(0xFFB9EF7C), AppColors.splashBackground],
                ),
              ),
            ),
          ),

          // Hojas arriba a la derecha
          Positioned(
            top: -6,
            right: -34,
            child: _leaf(
              width: 140,
              height: 62,
              angle: 2.25,
              color: const Color(0xFF3F7D1F),
              phase: 0.0,
            ),
