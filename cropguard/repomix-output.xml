<file path="lib/features/auth/data/datasources/auth_remote_data_source.dart">
import 'package:supabase_flutter/supabase_flutter.dart';

import 'package:kroppi/core/errors/failures.dart';
import 'package:kroppi/features/auth/data/datasources/supabase_auth_service.dart';
import 'package:kroppi/features/auth/data/models/app_user_model.dart';
import 'package:kroppi/features/auth/domain/entities/sign_up_params.dart';

class AuthRemoteDataSource {
  const AuthRemoteDataSource(this._authService);

  final SupabaseAuthService _authService;

  Future<AppUserModel> signInWithGoogle() async {
    final response = await _authService.signInWithGoogle();
    final user = response.user;
    if (user == null) {
      throw const AuthException('No se pudo iniciar sesión con Google');
    }
    return _withProfile(user);
  }

  Future<AppUserModel> signInWithEmail({
    required String email,
    required String password,
  }) async {
    final response = await _authService.signInWithEmail(
      email: email,
      password: password,
    );
    final user = response.user;
    if (user == null) {
      throw const AuthException('Invalid login credentials');
    }
    return _withProfile(user);
  }

  Future<AppUserModel?> signUpWithEmail(SignUpParams params) async {
    final response = await _authService.signUpWithEmail(params);
    final user = response.user;
    if (user == null) {
      throw const AuthException('No se pudo crear la cuenta');
    }
    // Con la confirmación de correo activa, Supabase no devuelve error si el
    // correo ya existe: devuelve un usuario sin identidades.
    if (user.identities != null && user.identities!.isEmpty) {
      throw const AuthException('User already registered');
    }
    // Sin sesión = Supabase está esperando que se confirme el correo.
    if (response.session == null) return null;
    return _withProfile(user);
  }

  Future<void> signOut() {
    return _authService.signOut();
  }

  /// Sesión restaurada por el SDK + su perfil. Si la sesión existe pero el
  /// perfil no, se cierra y se trata como "sin sesión".
  Future<AppUserModel?> getCurrentUser() async {
    final user = _authService.currentUser;
    if (user == null) return null;
    final row = await _authService.fetchProfile(user.id);
    if (row == null) {
      await _authService.signOut();
      return null;
    }
    return AppUserModel.fromProfile(row, email: user.email ?? '');
  }

  /// Valida que el usuario tenga fila en `profiles`. Sin perfil no se
  /// permite entrar: se cierra la sesión y se informa.
  Future<AppUserModel> _withProfile(User user) async {
    final row = await _authService.fetchProfile(user.id);
    if (row == null) {
      await _authService.signOut();
      throw const NotFoundFailure(
        'Tu cuenta no tiene un perfil asociado. Contacta a soporte.',
      );
    }
    return AppUserModel.fromProfile(row, email: user.email ?? '');
  }
}
</file>

<file path="lib/features/auth/data/datasources/supabase_auth_service.dart">
import 'package:google_sign_in/google_sign_in.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import '../../domain/entities/sign_up_params.dart';

class SupabaseAuthService {
  SupabaseAuthService(this._client) : _googleSignIn = GoogleSignIn.instance;

  final SupabaseClient _client;
  final GoogleSignIn _googleSignIn;
  Future<void>? _googleSignInInitialization;

  static const _webClientId = String.fromEnvironment(
    'GOOGLE_WEB_CLIENT_ID',
    defaultValue:
        '302834720640-e91fk4kj1rnc3su728tccig6ogkisq7m.apps.googleusercontent.com',
  );
  static const _iosClientId = String.fromEnvironment('GOOGLE_IOS_CLIENT_ID');

  // ---------------- Correo y contraseña ----------------

  Future<AuthResponse> signInWithEmail({
    required String email,
    required String password,
  }) {
    return _client.auth.signInWithPassword(email: email, password: password);
  }

  /// Los datos del formulario viajan como metadata; el trigger
  /// `handle_new_user` los copia a `profiles` (ver supabase/01_registro_perfiles.sql).
  Future<AuthResponse> signUpWithEmail(SignUpParams params) {
    return _client.auth.signUp(
      email: params.email,
      password: params.password,
      data: {
        'full_name': params.fullName,
        if (params.phoneNumber != null) 'phone_number': params.phoneNumber,
        if (params.municipality != null) 'municipality': params.municipality,
        if (params.department != null) 'department': params.department,
        'role': params.role,
      },
    );
  }

  // ---------------- Google (sin cambios) ----------------

  Future<AuthResponse> signInWithGoogle() async {
    if (_webClientId.isEmpty) {
      throw const AuthException(
        'Configura GOOGLE_WEB_CLIENT_ID para habilitar el inicio con Google.',
      );
    }

    await (_googleSignInInitialization ??= _googleSignIn.initialize(
      serverClientId: _webClientId,
      clientId: _iosClientId.isEmpty ? null : _iosClientId,
    ));

    final googleUser = await _googleSignIn.authenticate();
    final idToken = googleUser.authentication.idToken;

    if (idToken == null) {
      throw const AuthException('No se obtuvo el ID token de Google');
    }

    return _client.auth.signInWithIdToken(
      provider: OAuthProvider.google,
      idToken: idToken,
    );
  }

  // ---------------- Perfil ----------------

  /// Fila de `public.profiles` del usuario, o null si no existe.
  Future<Map<String, dynamic>?> fetchProfile(String userId) {
    return _client.from('profiles').select().eq('id', userId).maybeSingle();
  }

  // ---------------- Sesión ----------------

  Future<void> signOut() async {
    // Con google_sign_in 7.x, signOut() exige haber llamado a initialize().
    // Quien entró con correo nunca lo hizo, así que solo cerramos Google
    // cuando se usó en esta ejecución.
    if (_googleSignInInitialization != null) {
      try {
        await _googleSignIn.signOut();
      } catch (_) {}
    }
    await _client.auth.signOut();
  }

  User? get currentUser => _client.auth.currentUser;

  Stream<AuthState> get authStateChanges => _client.auth.onAuthStateChange;
}
</file>

<file path="lib/features/auth/data/models/app_user_model.dart">
import '../../domain/entities/app_user.dart';

class AppUserModel extends AppUser {
  const AppUserModel({
    required super.id,
    required super.email,
    required super.fullName,
    super.role,
    super.phoneNumber,
    super.municipality,
    super.department,
    super.avatarUrl,
  });

  /// [row] es una fila de `public.profiles`; el correo viene de auth.users
  /// porque `profiles` no lo guarda.
  factory AppUserModel.fromProfile(
    Map<String, dynamic> row, {
    required String email,
  }) {
    String? text(String key) {
      final value = row[key]?.toString().trim();
      return (value == null || value.isEmpty) ? null : value;
    }

    final fallbackName = email.contains('@')
        ? email.split('@').first
        : 'Agricultor';

    return AppUserModel(
      id: row['id'].toString(),
      email: email,
      fullName: text('full_name') ?? fallbackName,
      role: text('role') ?? 'FARMER',
      phoneNumber: text('phone_number'),
      municipality: text('municipality'),
      department: text('department'),
      avatarUrl: text('avatar_url'),
    );
  }
}
