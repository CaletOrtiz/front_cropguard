                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

/// Decoración de la esquina superior derecha, dibujada con código.
class _DecorPainter extends CustomPainter {
  const _DecorPainter(this.tone);

  final QuickAccessTone tone;

  void _leaf(
    Canvas canvas,
    Offset base,
    double len,
    double wid,
    double angle,
    Color color,
  ) {
    canvas.save();
    canvas.translate(base.dx, base.dy);
    canvas.rotate(angle);

    final path = Path()
      ..moveTo(0, 0)
      ..cubicTo(len * 0.25, -wid * 0.7, len * 0.75, -wid * 0.55, len, 0)
      ..cubicTo(len * 0.75, wid * 0.55, len * 0.25, wid * 0.7, 0, 0)
      ..close();
    canvas.drawPath(path, Paint()..color = color);

    canvas.drawLine(
      Offset(len * 0.05, 0),
      Offset(len * 0.9, 0),
      Paint()
        ..color = Colors.white.withValues(alpha: 0.35)
        ..strokeWidth = 1.1
        ..strokeCap = StrokeCap.round,
    );
    canvas.restore();
  }

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    switch (tone) {
      case QuickAccessTone.mint:
        _leaf(
          canvas,
          Offset(w * 0.92, h * 0.95),
          58,
          26,
          -2.35,
          const Color(0xFF2E7D4F),
        );
        _leaf(
          canvas,
          Offset(w * 0.80, h * 1.0),
          50,
          22,
          -1.85,
          const Color(0xFF5FAE63),
        );
        _leaf(
          canvas,
          Offset(w * 1.0, h * 0.80),
          40,
          18,
          -2.9,
          const Color(0xFFA5D6A7),
        );

      case QuickAccessTone.lime:
        final stem = Offset(w * 0.78, h * 1.0);
        canvas.drawLine(
          stem,
          Offset(w * 0.78, h * 0.42),
          Paint()
            ..color = const Color(0xFF4C9A2A)
            ..strokeWidth = 2.5
            ..strokeCap = StrokeCap.round,
        );
        _leaf(
          canvas,
          Offset(w * 0.78, h * 0.66),
          38,
          17,
          -2.5,
          const Color(0xFF4C9A2A),
        );
        _leaf(
          canvas,
          Offset(w * 0.78, h * 0.50),
          44,
          19,
          -0.65,
          const Color(0xFF6DBE45),
        );
        _leaf(
          canvas,
          Offset(w * 0.78, h * 0.86),
          30,
          14,
          -0.35,
          const Color(0xFF8CD06A),
        );

      case QuickAccessTone.sun:
        canvas.drawCircle(
          Offset(w * 0.85, h * 0.42),
          34,
          Paint()..color = const Color(0xFFFFE08A).withValues(alpha: 0.65),
        );
        _leaf(
          canvas,
          Offset(w * 0.95, h * 0.95),
          56,
          26,
          -2.2,
          const Color(0xFF4C9A2A),
        );

      case QuickAccessTone.sky:
        final far = Path()
          ..moveTo(0, h * 0.80)
          ..quadraticBezierTo(w * 0.30, h * 0.35, w * 0.62, h * 0.62)
          ..quadraticBezierTo(w * 0.85, h * 0.78, w, h * 0.45)
          ..lineTo(w, h)
          ..lineTo(0, h)
          ..close();
        canvas.drawPath(
          far,
          Paint()..color = const Color(0xFF9CC3E4).withValues(alpha: 0.8),
        );
        final near = Path()
          ..moveTo(w * 0.15, h)
          ..quadraticBezierTo(w * 0.50, h * 0.55, w, h * 0.75)
          ..lineTo(w, h)
          ..close();
        canvas.drawPath(
          near,
          Paint()..color = const Color(0xFFBBD7EE).withValues(alpha: 0.9),
        );
        canvas.drawCircle(
          Offset(w * 0.30, h * 0.28),
          8,
          Paint()..color = Colors.white.withValues(alpha: 0.7),
        );
    }
  }

  @override
  bool shouldRepaint(covariant _DecorPainter old) => old.tone != tone;
}
</file>

<file path="lib/features/profile/data/datasources/profile_remote_data_source.dart">
import 'package:supabase_flutter/supabase_flutter.dart';

import 'package:kroppi/features/auth/data/models/app_user_model.dart';
import '../../domain/entities/update_profile_params.dart';

class ProfileRemoteDataSource {
  const ProfileRemoteDataSource(this._client);

  final SupabaseClient _client;

  static const _bucket = 'avatars';
  static const _publicPrefix = '/storage/v1/object/public/$_bucket/';

  /// 1) Sube la foto (si hay) a `avatars/<uid>/...`.
  /// 2) Llama a la función `update_my_profile`, que valida el rol y guarda
  ///    celular, municipio, rol y foto en `profiles`.
  /// 3) Borra la foto anterior.
  Future<AppUserModel> updateProfile(UpdateProfileParams params) async {
    final authUser = _client.auth.currentUser;
    if (authUser == null) {
      throw const AuthException('Tu sesión expiró. Inicia sesión de nuevo.');
    }

    String? uploadedPath;
    String? avatarUrl;

    final avatar = params.avatar;
    if (avatar != null) {
      final stamp = DateTime.now().millisecondsSinceEpoch;
      uploadedPath =
          '${authUser.id}/avatar_$stamp.${_extension(avatar.contentType)}';
      await _client.storage
          .from(_bucket)
          .uploadBinary(
            uploadedPath,
            avatar.bytes,
            fileOptions: FileOptions(contentType: avatar.contentType),
          );
      avatarUrl = _client.storage.from(_bucket).getPublicUrl(uploadedPath);
    }

    Object? result;
    try {
      result = await _client.rpc(
        'update_my_profile',
        params: {
          'p_phone_number': params.phoneNumber,
          'p_municipality': params.municipality,
          'p_role': params.role,
          'p_avatar_url': avatarUrl,
        },
      );
    } catch (_) {
      // No dejar una foto huérfana si el perfil no se pudo guardar.
      if (uploadedPath != null) await _removeQuietly(uploadedPath);
      rethrow;
    }

    if (result is! Map) {
      throw const PostgrestException(
        message: 'Respuesta inesperada al guardar el perfil.',
      );
    }

    if (avatarUrl != null) {
      final oldPath = _pathFromPublicUrl(
        params.previousAvatarUrl,
        authUser.id,
      );
      if (oldPath != null && oldPath != uploadedPath) {
        await _removeQuietly(oldPath);
      }
    }

    return AppUserModel.fromProfile(
      Map<String, dynamic>.from(result),
      email: authUser.email ?? '',
    );
  }

  String _extension(String contentType) => switch (contentType) {
    'image/png' => 'png',
    'image/webp' => 'webp',
    _ => 'jpg',
  };

  /// Ruta dentro del bucket si la URL es una foto propia del usuario; null
  /// para fotos de otro origen (por ejemplo, la de Google).
  String? _pathFromPublicUrl(String? url, String userId) {
    if (url == null) return null;
    final index = url.indexOf(_publicPrefix);
    if (index < 0) return null;
    final path = Uri.decodeComponent(
      url.substring(index + _publicPrefix.length).split('?').first,
    );
    return path.startsWith('$userId/') ? path : null;
  }

  Future<void> _removeQuietly(String path) async {
    try {
      await _client.storage.from(_bucket).remove([path]);
    } catch (_) {
      // Limpieza opcional: si falla, no se interrumpe el guardado.
    }
  }
}
</file>

